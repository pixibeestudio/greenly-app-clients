<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton placeholder cho 1 card sản phẩm ngang (160dp width, giống item_product_horizontal) -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <!-- Ảnh sản phẩm placeholder -->
        <View
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="#EEEEEE" />

        <!-- Dòng nguồn gốc + đánh giá -->
        <View
            android:layout_width="100dp"
            android:layout_height="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_shimmer_rounded" />

        <!-- Tên sản phẩm -->
        <View
            android:layout_width="120dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_shimmer_rounded" />

        <!-- Giá sản phẩm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="80dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_shimmer_rounded" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Nút thêm giỏ hàng -->
            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_shimmer_rounded_16" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
